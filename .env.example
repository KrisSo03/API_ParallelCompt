# NASA POWER API Configuration
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/v1/
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_MAX_RETRIES=3
NASA_POWER_RETRY_BACKOFF_FACTOR=2.0

# Date Range Configuration
DATE_RANGE_START_YEAR=2020
DATE_RANGE_END_YEAR=2023

# Grid Configuration
GRID_SIZE=20
GRID_ENABLE_SAMPLING=true
GRID_SAMPLE_SIZE=20

# Scoring Configuration
SCORING_WEIGHT_SOLAR=0.5
SCORING_WEIGHT_WIND=0.3
SCORING_WEIGHT_HYBRID=0.2

# Clustering Configuration
CLUSTERING_N_CLUSTERS=4
CLUSTERING_RANDOM_STATE=42

# Benchmark Configuration
BENCHMARK_WORKER_COUNTS=1,2,4,8
BENCHMARK_REPEATS_PER_CONFIG=3

# Paths Configuration
PATH_DATA_DIR=./data
PATH_RESULTS_DIR=./results
PATH_LOGS_DIR=./outputs/logs
